# Copy to .env and fill in. Never commit .env.

# Cratio CRM (used by src/lib/crm.ts for /api/leads).
# Without CRATIO_API_KEY: leads are only logged in dev, and rejected in production.
CRATIO_API_KEY=
CRATIO_LEAD_CREATED_BY=
CRATIO_ASSIGNED_TO=
# Optional: overrides the per-form lead source for every lead.
CRATIO_LEAD_SOURCE=Website
